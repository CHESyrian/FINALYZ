# --- Django Config ---------------------------------------------------------------------

SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1


# --- AI commentary ----------------------------------------

# Options: auto | openrouter | cerebras | groq | gemini
# auto tries (free tiers): openrouter → cerebras → groq → gemini

AI_PROVIDER=auto
AI_REQUEST_TIMEOUT=30


# --- PROVIDERS -------------------------------------------------------------------------

# --- OpenRouter (recommended free) 

# https://openrouter.ai/keys  — use a model id ending in :free
#OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_FREE_MODELS=stealth/ox-alpha,nvidia/nemotron-nano-9b-v2:free,nvidia/nemotron-3-nano-30b-a3b:free,nvidia/nemotron-3.5-lightning:free,nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-26b-a4b-it:free,google/gemma-4-31b-it:free,liquid/lfm-2.5-2.6b:free,z-ai/glm-5.2:free,cohere/north-mini-code:free,thinkingmachines/inkling-small:free,poolside/laguna-xs-2.1:free,openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:8000
OPENROUTER_APP_NAME=Financial Analyzer


# --- Cerebras (free tier) 

# https://cloud.cerebras.ai
#CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama3.1-8b
CEREBRAS_FREE_MODELS=llama3.1-8b,llama-3.3-70b,gpt-oss-120b,qwen-3-32b,zai-glm-4.7
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1


# --- Groq (free tier) 

# https://console.groq.com
#GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FREE_MODELS=llama-3.1-8b-instant,openai/gpt-oss-20b,openai/gpt-oss-120b,llama-3.3-70b-versatile,qwen/qwen3.6-27b,groq/compound-mini,gemma2-9b-it
GROQ_BASE_URL=https://api.groq.com/openai/v1


# --- Google Gemini (free tier via AI Studio) 

# https://aistudio.google.com/apikey  (may fail outside supported regions)
#GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FREE_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.1-flash,gemini-2.5-flash,gemini-3.7-flash-lite,gemini-3.6-flash-lite,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite


